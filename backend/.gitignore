# ==============================================================================
# Backend .gitignore - Node.js / Express
# ==============================================================================

# 1. Dependency Directories
node_modules/
jspm_packages/
web_modules/

# 2. Environment Variables & Secret Credentials (CRITICAL)
.env
.env.local
.env.development
.env.test
.env.production
.env.*.local
*.env

# Exception: Allow committed example templates
!.env.example

# 3. Log Files & Monitoring
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 4. Runtime Data, PIDs, & Temporary Dumps
pids/
*.pid
*.seed
*.pid.lock
temp/
tmp/

# 5. Testing & Code Coverage
coverage/
.nyc_output/

# 6. Operating System Files
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
desktop.ini

# Linux
*~

# 7. IDEs & Code Editors (Optional Local Settings)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
